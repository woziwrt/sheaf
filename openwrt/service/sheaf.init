#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 Petr Wozniak
# sheaf: bond the board's LTE modems to the server (IPsec + sheaf), started at boot, supervised by procd.
START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/sheaf-run
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 30 # the supervisor cleans up on TERM (sheaf, IPsec, modems down)
	procd_close_instance
}

# stop: procd sends TERM to the supervisor, which cleans up itself (a separate stop_service killing the loop
# would look like a crash to procd and get respawned)
