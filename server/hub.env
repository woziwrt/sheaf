# /opt/sheaf/hub.env - sheaf server instance for the hub (BPI-R4 sheaf-hub, 4 links through 2 RBM33G satellites)
LINKS=0.0.0.0:47021>-,0.0.0.0:47022>-,0.0.0.0:47023>-,0.0.0.0:47024>-
TUN=shf2
ADDR=10.66.0.9/30
KEY=/etc/sheaf/hub.key
# the hub's links run under IPsec: frames of 1328 B, as on the hub (the template's 1400 is for links without IPsec;
# with it every server frame would leave as two ESP fragments)
FRAME=1328
